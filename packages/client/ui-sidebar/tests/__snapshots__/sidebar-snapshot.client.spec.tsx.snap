// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sidebar shell snapshots > renders Windows caption controls in expanded and collapsed states > windows collapsed 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root collapsed railIn quietBars"
    style=""
  >
    <div
      class="logoRow"
      data-window-drag="true"
    >
      <button
        aria-label="Open sidebar"
        class="iconButton toggle"
        data-sidebar-toggle="true"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="panelIcon"
          data-content="d95b7908"
          data-icon="dsw-icon-panel-left-outline-regular"
          height="16"
          width="16"
        />
        <div
          data-slot="sidebar.toggle.badge"
          style="display: contents;"
        />
      </button>
    </div>
    <button
      aria-label="New session"
      class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4 shrink-0 [&_svg]:shrink-0 outline-none focus-visible:ring-[3px] focus-visible:ring-ring/40 focus-visible:border-ring bg-primary text-primary-foreground shadow-xs hover:bg-primary/90 h-9 px-4 py-2 has-[>svg]:px-3 newSession"
      data-slot="button"
      type="button"
    >
      <span
        class="newSessionLabelMask"
      >
        <span
          class="newSessionContent"
        >
          <svg
            aria-hidden="true"
            data-content="6e5e38f3"
            data-icon="dsw-icon-new-chat-outline-regular"
            height="16"
            width="16"
          />
        </span>
      </span>
    </button>
    <div
      class="scrollRegion"
    >
      <div
        class="scrollArea"
      >
        <div
          class="regionArea"
        >
          <div
            data-slot="sidebar.workspaces"
            style="display: contents;"
          />
        </div>
      </div>
      <span
        aria-hidden="true"
        class="scrollFade"
      />
    </div>
    <div
      class="footArea"
    >
      <div
        class="footerActions"
      >
        <div
          data-slot="sidebar.footer.action"
          style="display: contents;"
        />
      </div>
      <div
        class="settingsArea"
      >
        <div
          data-slot="sidebar.settings"
          style="display: contents;"
        />
      </div>
    </div>
  </div>
</div>
`;

exports[`sidebar shell snapshots > renders Windows caption controls in expanded and collapsed states > windows expanded 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root quietBars"
    style="width: 300px;"
  >
    <div
      class="logoRow"
      data-window-drag="true"
    >
      <button
        aria-label="New session"
        class="brand wide"
        type="button"
      >
        <span
          aria-hidden="true"
          class="brandIdentity"
        >
          <span
            class="brandMark"
          >
            <div
              data-slot="sidebar.brand.mark"
              style="display: contents;"
            >
              <span
                class="copyVersion"
                data-copy-version="true"
              >
                <svg
                  aria-hidden="true"
                  data-content="41209921"
                  fill="none"
                  height="22.089916715676043"
                  viewBox="0 0 5271.1 4851.59"
                  width="24"
                />
              </span>
            </div>
          </span>
          <span
            class="brandName"
          >
            <div
              data-slot="sidebar.brand.name"
              style="display: contents;"
            >
              <span
                class="localBuildBrand copyVersion"
                data-copy-version="true"
              >
                <span
                  class="localBuildTitle"
                >
                  thegacs
                </span>
                <span
                  class="buildVersion"
                >
                  1.2.3-rc.4-abc1234-dirty
                </span>
              </span>
            </div>
          </span>
        </span>
      </button>
      <button
        aria-label="Collapse sidebar"
        class="iconButton toggle"
        data-sidebar-toggle="true"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="panelIcon"
          data-content="d95b7908"
          data-icon="dsw-icon-panel-left-outline-regular"
          height="16"
          width="16"
        />
      </button>
    </div>
    <button
      aria-label="New session"
      class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4 shrink-0 [&_svg]:shrink-0 outline-none focus-visible:ring-[3px] focus-visible:ring-ring/40 focus-visible:border-ring bg-primary text-primary-foreground shadow-xs hover:bg-primary/90 h-9 px-4 py-2 has-[>svg]:px-3 newSession"
      data-slot="button"
      type="button"
    >
      <span
        class="newSessionLabelMask"
      >
        <span
          class="newSessionContent"
        >
          <svg
            aria-hidden="true"
            data-content="532cf99a"
            data-icon="dsw-icon-new-chat-outline-medium"
            height="14"
            width="14"
          />
          <span
            class="newSessionLabel wide"
          >
            New Session
          </span>
        </span>
      </span>
    </button>
    <div
      class="scrollRegion"
    >
      <div
        class="scrollArea"
        data-sidebar-scrollport=""
      >
        <div
          class="regionArea"
        >
          <div
            data-slot="sidebar.workspaces"
            style="display: contents;"
          />
        </div>
      </div>
      <span
        aria-hidden="true"
        class="scrollFade"
      />
    </div>
    <div
      class="footArea"
    >
      <div
        class="footerActions"
      >
        <div
          data-slot="sidebar.footer.action"
          style="display: contents;"
        />
      </div>
      <div
        class="settingsArea"
      >
        <div
          data-slot="sidebar.settings"
          style="display: contents;"
        />
      </div>
    </div>
  </div>
</div>
`;

